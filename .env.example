# Copy to .env and fill in. .env is gitignored — never commit the real values,
# and never show them in the demo video (crop the `bdata login` key echo).

# Bright Data API key (from `bdata login` / dashboard). The bdata CLI reads its
# own stored credential after `bdata login`; this is here for the runner's
# direct-API path (P1) and for documentation.
BRIGHTDATA_API_KEY=

# Path to Canary's SQLite database (created by `canary init-db`).
CANARY_DB=data/canary.db

# Logical source name for the monitored collector.
CANARY_SOURCE=ikea

# Pinned Scraper Studio collector id (c_*). Not a secret.
# Also mirrored into CLAUDE.md so the agent never creates a second collector.
SCRAPER_STUDIO_COLLECTOR_ID=c_mt07a4h921tnzr8kvt
